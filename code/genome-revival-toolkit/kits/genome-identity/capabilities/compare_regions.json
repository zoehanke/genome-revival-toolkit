{
  "schema": "capability-v1",
  "id": "identity.compare_regions",
  "version": "0.0.0",
  "role": "ACTION",
  "summary": "Compare explicit supplied intervals by exact equality and unit-cost global edit distance.",
  "effects": [
    "pure"
  ],
  "deterministic": true,
  "requires_runtime": [
    {
      "kind": "python_package",
      "name": "biopython",
      "probe": null
    }
  ],
  "inputs": [
    {
      "name": "reference_original",
      "type": "material",
      "required": true,
      "constraints": {},
      "description": "reference original"
    },
    {
      "name": "reference_edited",
      "type": "material",
      "required": true,
      "constraints": {},
      "description": "reference edited"
    }
  ],
  "outputs": [
    {
      "name": "comparison",
      "type": "document",
      "schema": {
        "type": "object",
        "properties": {
          "schema": {
            "const": "region-comparison-v1"
          },
          "original": {
            "type": "object",
            "properties": {
              "material_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "material_id",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "edited": {
            "type": "object",
            "properties": {
              "material_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "material_id",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "identical": {
            "type": "boolean"
          },
          "edit_distance": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "schema",
          "original",
          "edited",
          "identical",
          "edit_distance"
        ],
        "additionalProperties": false
      },
      "output_role": "analysis"
    }
  ],
  "params": {
    "type": "object",
    "properties": {
      "original_start": {
        "type": "integer",
        "minimum": 0
      },
      "original_end": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "edited_start": {
        "type": "integer",
        "minimum": 0
      },
      "edited_end": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "step_checks": [],
  "final_checks": [],
  "does_not_establish": [
    "Primer specificity in an actual strain.",
    "Observed experimental products.",
    "Authentic genotype.",
    "Whole-genome discrimination outside supplied references."
  ],
  "source": {
    "algorithm_refs": [
      "spec/SPEC.md D11",
      "MIGRATION-LOG.md S5b"
    ],
    "implemented_in": "grt_kit_genome_identity.capabilities.operations:compare_regions"
  },
  "owner": "kit:genome-identity",
  "granularity": "atomic"
}
