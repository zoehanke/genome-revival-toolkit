{
  "schema": "capability-v1",
  "id": "construct.design_junction_assay",
  "version": "0.0.0",
  "role": "ACTION",
  "summary": "Design external junction primers or assess supplied primers on original, edited and donor backgrounds.",
  "effects": [
    "reads_files"
  ],
  "deterministic": true,
  "requires_runtime": [
    {
      "kind": "python_package",
      "name": "biopython",
      "probe": null
    }
  ],
  "inputs": [
    {
      "name": "original",
      "type": "material",
      "required": true,
      "constraints": {},
      "description": "original"
    },
    {
      "name": "edited",
      "type": "material",
      "required": true,
      "constraints": {},
      "description": "edited"
    },
    {
      "name": "donor",
      "type": "material",
      "required": true,
      "constraints": {},
      "description": "donor"
    },
    {
      "name": "primer_file",
      "type": "artifact",
      "required": false,
      "constraints": {},
      "description": "primer file"
    }
  ],
  "params": {
    "type": "object",
    "properties": {
      "start": {
        "type": "integer",
        "minimum": 0
      },
      "end": {
        "type": "integer",
        "minimum": 0
      },
      "arm_length": {
        "type": "integer",
        "minimum": 1
      },
      "primer_length": {
        "type": "integer",
        "minimum": 2
      }
    },
    "required": [
      "start",
      "end",
      "arm_length",
      "primer_length"
    ],
    "additionalProperties": false
  },
  "outputs": [
    {
      "name": "primers",
      "type": "document",
      "output_role": "primer_set",
      "schema": {
        "type": "object",
        "properties": {
          "schema": {
            "const": "primer-set-v1"
          },
          "primers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "sequence": {
                  "type": "string",
                  "pattern": "^[ACGT]+$"
                },
                "core_length": {
                  "type": "integer",
                  "minimum": 1
                },
                "purpose": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "sequence",
                "core_length",
                "purpose"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "forward": {
                  "type": "string"
                },
                "reverse": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "forward",
                "reverse"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "schema",
          "primers",
          "pairs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "assay",
      "type": "document",
      "output_role": "analysis",
      "schema": {
        "type": "object",
        "properties": {
          "schema": {
            "const": "junction-assay-v1"
          },
          "original_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "edited_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "donor_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "primers": {
            "type": "object",
            "properties": {
              "schema": {
                "const": "primer-set-v1"
              },
              "primers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "sequence": {
                      "type": "string",
                      "pattern": "^[ACGT]+$"
                    },
                    "core_length": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "purpose": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "sequence",
                    "core_length",
                    "purpose"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2
              },
              "pairs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "forward": {
                      "type": "string"
                    },
                    "reverse": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "forward",
                    "reverse"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "schema",
              "primers",
              "pairs"
            ],
            "additionalProperties": false
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "reference_id": {
                  "type": "string"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "reference_id",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "backgrounds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "enum": [
                    "original",
                    "edited",
                    "donor"
                  ]
                },
                "predictions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pair_id": {
                        "type": "string"
                      },
                      "product_count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "product_bp": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "forward_sites": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "reverse_sites": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "pair_id",
                      "product_count",
                      "product_bp",
                      "forward_sites",
                      "reverse_sites"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "predictions"
              ],
              "additionalProperties": false
            },
            "minItems": 3
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "schema",
          "original_id",
          "edited_id",
          "donor_id",
          "primers",
          "regions",
          "backgrounds",
          "warnings"
        ],
        "additionalProperties": false
      }
    }
  ],
  "step_checks": [],
  "final_checks": [
    {
      "check": "construct.check_junction_assay"
    }
  ],
  "does_not_establish": [
    "Successful laboratory donor preparation",
    "Transformation efficiency",
    "Authentic integration locus",
    "Functional revival"
  ],
  "source": {
    "algorithm_refs": [
      "spec/SPEC.md D3 D7 D11",
      "MIGRATION-LOG.md: S5a"
    ],
    "implemented_in": "construct.capabilities.assay:design_junction_assay"
  },
  "owner": "kit:construct",
  "granularity": "atomic"
}
