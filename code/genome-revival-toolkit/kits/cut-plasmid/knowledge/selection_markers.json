        "version": 1,
        "status": "active",
        "purpose": "interpretation",
        "evaluator": "cut_plasmid.assess_selection",
        "parameters": {
          "marker_id": "ble",
          "pattern": "\\b(?:ble|bler|bleor|sh\\s+ble|zeocin|phleomycin|bleomycin)\\b",
          "host": "yeast",
          "plate": "YPD or minimal medium + Zeocin (reported working range 50–300 µg/mL; the lowest effective dose depends on strain, pH and ionic strength, so determine it with a kill curve; test medium pH 6.5–8). Electroporated cells: YPD + 1 M sorbitol. Do not plate spheroplasts directly onto Zeocin medium.",
          "auxotrophy": null,
          "supplementary_sources": [
            {
              "source_class": "literature",
              "citation": "Drocourt D, Calmels T, Reynes JP, Baron M, Tiraby G. Cassettes of the Streptoalloteichus hindustanus ble gene for transformation of lower and higher eukaryotes to phleomycin resistance. Nucleic Acids Research 18(13):4009 (1990). PMID 1695734; doi 10.1093/nar/18.13.4009; PMC331125",
              "locator": "https://pmc.ncbi.nlm.nih.gov/articles/PMC331125/",
