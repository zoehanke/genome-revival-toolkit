    "truth_table": [
      {
        "when": [{"field": "count_known", "op": "eq", "value": false}],
        "status": "NOT_TESTED",
        "reason": "融合平板计数缺失；缺失不是零",
        "source_ref": "evidence.fusion_plate_outgrowth"
      },
      {
        "when": [
          {"field": "count_known", "op": "eq", "value": true},
          {"field": "count_positive", "op": "eq", "value": false}
        ],
        "status": "CONTRADICTED",
        "reason": "融合平板报告没有菌落，所谓\"生长\"不成立",
        "source_ref": "evidence.fusion_plate_outgrowth"
      },
      {
        "when": [
          {"field": "count_positive", "op": "eq", "value": true},
          {"field": "control_count_known", "op": "eq", "value": false}
        ],
        "status": "INSUFFICIENT",
        "reason": "融合平板有菌落，但对照计数缺失，无法判断生长是否与对照不同",
        "source_ref": "evidence.fusion_plate_outgrowth"
      },
      {
        "when": [
          {"field": "count_positive", "op": "eq", "value": true},
          {"field": "control_count_positive", "op": "eq", "value": true}
        ],
        "status": "INSUFFICIENT",
        "reason": "对照也出了菌落，无法把融合平板的生长归因于所报告的处理（对照的矛盾另由 control_no_outgrowth 单独报告）",
        "source_ref": "evidence.fusion_plate_outgrowth"
      },
      {
        "when": [
          {"field": "count_positive", "op": "eq", "value": true},
          {"field": "control_count_known", "op": "eq", "value": true},
          {"field": "control_count_positive", "op": "eq", "value": false}
        ],
        "status": "SUPPORTED",
        "reason": "融合平板有菌落而指定的无生长对照没有；这不证明功能复活，也不证明对照细胞已死",
        "source_ref": "evidence.fusion_plate_outgrowth"
      }
    ]
  },
