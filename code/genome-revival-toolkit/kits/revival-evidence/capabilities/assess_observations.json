{
  "schema": "capability-v1",
  "id": "evidence.assess_observations",
  "version": "0.0.0",
  "role": "ACTION",
  "summary": "Apply sourced claim evidence tables; report bounded conclusions and unperformed tests.",
  "effects": [
    "reads_files"
  ],
  "deterministic": true,
  "requires_runtime": [],
  "inputs": [
    {
      "name": "document",
      "type": "document",
      "schema": {
        "type": "object",
        "properties": {
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "group": {
                  "type": "string",
                  "minLength": 1
                },
                "colonies": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "plated_cells": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "plated_volume_uL": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "group",
                "colonies",
                "plated_cells",
                "plated_volume_uL",
                "unit",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "genotype_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sample_id": {
                  "type": "string",
                  "minLength": 1
                },
                "assay_id": {
                  "type": "string",
                  "minLength": 1
                },
                "background_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reference_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "result": {
                  "enum": [
                    "positive",
                    "negative",
                    "indeterminate",
                    "not_tested"
                  ]
                },
                "control_status": {
                  "enum": [
                    "passed",
                    "failed",
                    "unknown"
                  ]
                },
                "observed_band_bp": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "band_tolerance_bp": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "sample_id",
                "assay_id",
                "background_id",
                "result",
                "control_status",
                "observed_band_bp",
                "band_tolerance_bp"
              ],
              "additionalProperties": false
            }
          },
          "functional_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sample_id": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "enum": [
                    "positive",
                    "negative",
                    "indeterminate",
                    "not_tested"
                  ]
                }
              },
              "required": [
                "sample_id",
                "result"
              ],
              "additionalProperties": false
            }
          },
          "observation_origin": {
            "type": "string",
            "minLength": 1
          },
          "predictions": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "schema": {
                    "const": "identity-expected-results-v1"
                  },
                  "assay_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "backgrounds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reference_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "primer_pair": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "expected": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "enum": [
                                "DISTINGUISHABLE",
                                "NOT_DISTINGUISHABLE",
                                "UNDETERMINED"
                              ]
                            },
                            "product_count": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "product_bp": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 1
                            }
                          },
                          "required": [
                            "status",
                            "product_count",
                            "product_bp"
                          ],
                          "additionalProperties": false,
                          "allOf": [
                            {
                              "if": {
                                "properties": {
                                  "product_count": {
                                    "const": 1
                                  }
                                },
                                "required": [
                                  "product_count"
                                ]
                              },
                              "then": {
                                "properties": {
                                  "product_bp": {
                                    "type": "integer",
                                    "minimum": 1
                                  }
                                }
                              },
                              "else": {
                                "properties": {
                                  "product_bp": {
                                    "type": "null"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "reference_sha256",
                        "primer_pair",
                        "expected"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "schema",
                  "assay_id",
                  "backgrounds"
                ],
                "additionalProperties": false
              }
            ]
          },
          "generated_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "row",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "input_files": {
            "type": "object",
            "properties": {
              "observations_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "predictions_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "observations_sha256",
              "predictions_sha256"
            ],
            "additionalProperties": false
          },
          "unverified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "observations",
          "genotype_results",
          "functional_results",
          "observation_origin",
          "predictions",
          "generated_ids",
          "input_files",
          "unverified"
        ],
        "additionalProperties": false
      },
      "required": true,
      "constraints": {},
      "description": "Normalized parse_observations document."
    }
  ],
  "params": {
    "type": "object",
    "properties": {
      "comparisons": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "experiment_group",
            "control_group"
          ],
          "properties": {
            "experiment_group": {
              "type": "string",
              "minLength": 1
            },
            "control_group": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "additionalProperties": false
  },
  "outputs": [
    {
      "name": "assessment",
      "type": "document",
      "schema": {
        "type": "object",
        "properties": {
          "conclusions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "subject": {
                  "type": "object",
                  "properties": {
                    "sample_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "assay_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "background_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "experiment_group": {
                      "type": "string",
                      "minLength": 1
                    },
                    "control_group": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "status": {
                  "enum": [
                    "SUPPORTED",
                    "INSUFFICIENT",
                    "CONTRADICTED",
                    "NOT_TESTED"
                  ]
                },
                "applicability": {
                  "enum": [
                    "PASS",
                    "UNKNOWN"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "rule_ref": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "claim",
                "subject",
                "status",
                "applicability",
                "reason",
                "rule_ref"
              ],
              "additionalProperties": false
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group": {
                  "type": "string",
                  "minLength": 1
                },
                "sample_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "colonies": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "record_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "units": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "group",
                "sample_ids",
                "colonies",
                "record_count",
                "units"
              ],
              "additionalProperties": false
            }
          },
          "comparisons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "experiment_group": {
                  "type": "string",
                  "minLength": 1
                },
                "control_group": {
                  "type": "string",
                  "minLength": 1
                },
                "experiment_colonies": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "control_colonies": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "difference": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "outcome": {
                  "enum": [
                    "PASS",
                    "UNKNOWN"
                  ]
                },
                "equal_reported_plated_volumes": {
                  "type": "boolean"
                },
                "limits": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "experiment_group",
                "control_group",
                "experiment_colonies",
                "control_colonies",
                "difference",
                "outcome",
                "equal_reported_plated_volumes",
                "limits"
              ],
              "additionalProperties": false
            }
          },
          "genotype_tests": {
            "enum": [
              "SUPPORTED",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_TESTED"
            ]
          },
          "functional_tests": {
            "enum": [
              "SUPPORTED",
              "INSUFFICIENT",
              "CONTRADICTED",
              "NOT_TESTED"
            ]
          },
          "observation_origin": {
            "type": "string",
            "minLength": 1
          },
          "rule_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "input_files": {
            "type": "object",
            "properties": {
              "observations_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "predictions_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "observations_sha256",
              "predictions_sha256"
            ],
            "additionalProperties": false
          },
          "generated_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "row",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "unverified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "conclusions",
          "groups",
          "comparisons",
          "genotype_tests",
          "functional_tests",
          "observation_origin",
          "rule_refs",
          "input_files",
          "generated_ids",
          "unverified",
          "limits"
        ],
        "additionalProperties": false
      },
      "output_role": "analysis"
    }
  ],
  "step_checks": [],
  "final_checks": [
    {
      "check": "evidence.check_record_consistency"
    }
  ],
  "does_not_establish": [
    "Experimental success (实验已成功).",
    "Functional revival (功能已复活).",
    "Authenticity of submitted observations (观察本身真实)."
  ],
  "source": {
    "algorithm_refs": [
      "SPEC D11, D12, B3; prompts/s3-revival-evidence.md"
