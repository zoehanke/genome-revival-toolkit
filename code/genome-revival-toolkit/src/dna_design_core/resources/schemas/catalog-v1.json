{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:catalog-v1",
  "title": "catalog-v1",
  "x-spec-ref": "D11; A11; D16/A14 e621b5c",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "catalog-v1"
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "const": "dev-tree"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "declaration": {
            "$ref": "urn:grt:schema:capability-v1"
          },
          "declaration_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "code_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "owner": {
            "type": "string",
            "pattern": "^(core|kit:[a-z][a-z0-9_-]*)$"
          }
        },
        "required": [
          "declaration",
          "declaration_digest",
          "code_digest",
          "owner"
        ],
        "additionalProperties": false
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pack": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "review": {
            "type": "object",
            "properties": {
              "none": {
                "type": "integer",
                "minimum": 0
              },
              "draft": {
                "type": "integer",
                "minimum": 0
              },
              "reviewed": {
                "type": "integer",
                "minimum": 0
              },
              "stale": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "none",
              "draft",
              "reviewed",
              "stale"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "pack",
          "digest",
          "review"
        ],
        "additionalProperties": false
      }
    },
    "kits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "code_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "manifest_sha256",
          "code_digest",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "profiles": {
      "$ref": "urn:grt:schema:profiles-v1"
    },
    "profiles_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vocab_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "release_id",
    "capabilities",
    "knowledge",
    "kits",
    "profiles",
    "profiles_digest",
    "vocab_digest"
  ],
  "additionalProperties": false
}
