{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:manifest-v1",
  "title": "manifest-v1",
  "x-spec-ref": "D8; A10; A14 (12c4274); D16/A14 e621b5c",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "manifest-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "const": "dev-tree"
        }
      ]
    },
    "goal_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pipeline_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "journal_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "environment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "sha256",
          "role",
          "labels"
        ],
        "additionalProperties": false
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "scope": {
            "enum": [
              "content_model",
              "preparation_model",
              "file",
              "user_goal"
            ]
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "verdict_event": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "check",
          "scope",
          "outcome",
          "verdict_event"
        ],
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "profiles_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "obligation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "profiles_digest",
        "obligation_ids"
      ],
      "additionalProperties": false
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    },
    "review_states": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    },
    "kit_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "code_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "manifest_sha256",
          "code_digest",
          "origin",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "run_id",
    "release_id",
    "goal_digest",
    "pipeline_digest",
    "revisions",
    "journal_head",
    "catalog_ids",
    "environment_ids",
    "files",
    "verdicts",
    "profile",
    "not_verified",
    "labels",
    "review_states",
    "kit_receipts"
  ],
  "additionalProperties": false
}
