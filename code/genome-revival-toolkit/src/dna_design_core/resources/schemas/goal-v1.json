{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:goal-v1",
  "title": "goal-v1",
  "x-spec-ref": "D2; D9; A1",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "goal-v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "parent_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "original_request": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "input_origin": {
            "enum": [
              "user_file",
              "researcher_observation"
            ]
          },
          "as": {
            "enum": [
              "material",
              "artifact"
            ]
          },
          "declared": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "$ref": "#/$defs/value"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "source_id",
          "path",
          "sha256",
          "input_origin",
          "declared"
        ],
        "additionalProperties": false
      }
    },
    "declared_context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "program",
              "ai_host",
              "human",
              "unknown"
            ]
          },
          "basis_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "origin",
          "basis_sources"
        ],
        "additionalProperties": false
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "construct",
              "component",
              "primer_set",
              "analysis"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "role",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "check": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*@[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "params": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "$ref": "#/$defs/value"
              }
            },
            "additionalProperties": false
          },
          "target": {
            "type": "string"
          },
          "source_quote": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "user_quoted",
              "host_derived"
            ]
          },
          "status": {
            "enum": [
              "active",
              "dropped"
            ]
          },
          "drop_reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "check",
          "params",
          "target",
          "source_quote",
          "origin",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_quote": {
            "type": "string"
          },
          "binds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "source_quote",
          "binds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "version",
    "parent_digest",
    "original_request",
    "sources",
    "declared_context",
    "targets",
    "constraints",
    "intents"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "parent_digest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
