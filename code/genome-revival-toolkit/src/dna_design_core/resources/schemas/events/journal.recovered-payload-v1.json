{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:journal.recovered-payload-v1",
  "title": "journal.recovered-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: journal.recovered",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "discarded_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "discarded_bytes",
    "reason"
  ],
  "additionalProperties": false
}
