{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:run.completed-payload-v1",
  "title": "run.completed-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: run.completed",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "pipeline_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executed_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      }
    }
  },
  "required": [
    "pipeline_digest",
    "executed_steps"
  ],
  "additionalProperties": false
}
