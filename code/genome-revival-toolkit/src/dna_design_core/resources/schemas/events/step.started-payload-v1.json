{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:step.started-payload-v1",
  "title": "step.started-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: step.started; A14 (12c4274)",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "declaration_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "declaration_digest",
        "code_digest"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "origin": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "step",
                    "artifact",
                    "literal"
                  ]
                },
                "ref": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "step_id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,31}$"
                        },
                        "port": {
                          "type": "string"
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "step_id",
                        "port"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "ref"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "source"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "ref": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "step"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "ref": {
                        "type": "object",
                        "properties": {
                          "step_id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{0,31}$"
                          },
                          "port": {
                            "type": "string"
                          },
                          "index": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "step_id",
                          "port"
                        ],
                        "additionalProperties": false
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "artifact"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000]+$"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "literal"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "ref": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "id",
            "origin"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    },
    "params_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "step_id",
    "capability",
    "inputs",
    "params",
    "params_digest"
  ],
  "additionalProperties": false
}
