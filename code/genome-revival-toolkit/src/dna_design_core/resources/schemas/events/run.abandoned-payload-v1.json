{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:run.abandoned-payload-v1",
  "title": "run.abandoned-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: run.abandoned; A14 (12c4274)",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "reason": {
      "type": "string"
    },
    "by": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "program",
            "ai_host",
            "human",
            "unknown"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "reason",
    "by"
  ],
  "additionalProperties": false
}
