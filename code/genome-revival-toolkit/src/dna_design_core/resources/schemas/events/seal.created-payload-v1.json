{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:seal.created-payload-v1",
  "title": "seal.created-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: seal.created; D16/A14 e621b5c",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "seal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "journal_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "const": "dev-tree"
        }
      ]
    },
    "labels": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "seal_id",
    "manifest_digest",
    "journal_head",
    "release_id",
    "labels"
  ],
  "additionalProperties": false
}
