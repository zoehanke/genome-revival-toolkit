{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:run.halted-payload-v1",
  "title": "run.halted-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: run.halted",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "reason": {
      "const": "step_failed"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    }
  },
  "required": [
    "reason",
    "step_id"
  ],
  "additionalProperties": false
}
