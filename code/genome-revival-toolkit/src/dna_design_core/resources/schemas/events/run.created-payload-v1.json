{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:run.created-payload-v1",
  "title": "run.created-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: run.created; A14 (12c4274); D16/A14 e621b5c",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "const": "dev-tree"
        }
      ]
    },
    "schema_versions": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "created_by": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "program",
            "ai_host",
            "human",
            "unknown"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "external_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "name",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "python",
        "platform",
        "packages",
        "external_tools",
        "config_digest"
      ],
      "additionalProperties": false
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_ref": {
      "type": "string"
    },
    "kits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "code_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "manifest_sha256",
          "code_digest",
          "origin",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "derived_from": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "seal_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "run_id",
        "seal_id"
      ],
      "additionalProperties": false
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "required": [
    "release_id",
    "schema_versions",
    "created_by",
    "environment",
    "catalog_id",
    "catalog_ref",
    "kits"
  ],
  "additionalProperties": false
}
