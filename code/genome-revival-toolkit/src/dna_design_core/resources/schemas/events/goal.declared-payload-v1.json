{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:goal.declared-payload-v1",
  "title": "goal.declared-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: goal.declared",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "goal_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "document": {
      "$ref": "urn:grt:schema:goal-v1"
    }
  },
  "required": [
    "goal_digest",
    "version",
    "document"
  ],
  "additionalProperties": false
}
