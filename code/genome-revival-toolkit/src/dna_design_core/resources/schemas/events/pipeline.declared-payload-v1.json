{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:pipeline.declared-payload-v1",
  "title": "pipeline.declared-payload-v1",
  "x-spec-ref": "D6; D9; Appendix E: pipeline.declared",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "pipeline_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "document": {
      "$ref": "urn:grt:schema:pipeline-v1"
    },
    "goal_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "library_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
            },
            "template_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "name",
            "version",
            "template_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "unbound_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "pipeline_digest",
    "version",
    "document",
    "goal_digest",
    "library_ref",
    "unbound_targets"
  ],
  "additionalProperties": false
}
