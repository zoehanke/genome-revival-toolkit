                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "pointer": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(|(/([^~/]|~[01])*)*)$"
                          },
                          {
                            "type": "string",
                            "pattern": "^\\{\\{[a-z][a-z0-9_]{0,31}\\}\\}$"
                          }
                        ]
                      }
                    },
                    "required": [
                      "source"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "step": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{0,31}$"
                          },
                          {
                            "type": "string",
                            "pattern": "^\\{\\{[a-z][a-z0-9_]{0,31}\\}\\}$"
                          }
                        ]
                      },
                      "port": {
                        "type": "string"
                      },
                      "index": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "string",
                            "pattern": "^\\{\\{[a-z][a-z0-9_]{0,31}\\}\\}$"
                          }
                        ]
                      },
                      "pointer": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(|(/([^~/]|~[01])*)*)$"
                          },
                          {
                            "type": "string",
                            "pattern": "^\\{\\{[a-z][a-z0-9_]{0,31}\\}\\}$"
                          }
                        ]
                      }
                    },
                    "required": [
                      "step",
                      "port"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "artifact": {
                        "type": "string"
                      },
                      "pointer": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(|(/([^~/]|~[01])*)*)$"
                          },
                          {
                            "type": "string",
                            "pattern": "^\\{\\{[a-z][a-z0-9_]{0,31}\\}\\}$"
                          }
                        ]
                      }
                    },
                    "required": [
                      "artifact"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "op": {
                "enum": [
                  "equals",
                  "gte",
                  "lte",
                  "between",
                  "contains",
                  "length_equals"
                ]
              },
              "value": {
                "$ref": "#/$defs/value"
              }
            },
            "required": [
              "on",
              "op",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "required": [
