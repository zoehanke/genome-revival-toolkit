{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:pipeline-template-v1",
  "title": "pipeline-template-v1",
  "x-spec-ref": "D4 templates; D20 RV-6; A3; A2/A9 optional authorship; A14 (12c4274); A14 (12c4274)",
  "$defs": {
    "value": {
      "anyOf": [
        {
