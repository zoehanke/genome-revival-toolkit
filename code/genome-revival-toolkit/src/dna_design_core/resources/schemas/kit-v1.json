{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:kit-v1",
  "title": "kit-v1",
  "x-spec-ref": "D11; A8",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "kit-v1"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string"
    },
    "requires_core": {
      "type": "object",
      "properties": {
        "minimum": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "maximum_exclusive": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "minimum",
        "maximum_exclusive"
      ],
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knowledge": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "capabilities",
        "knowledge",
        "templates",
        "text"
      ],
      "additionalProperties": false
    },
    "does_not_establish": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "name",
    "version",
    "title",
    "requires_core",
    "contributes",
    "does_not_establish",
    "review"
  ],
  "additionalProperties": false
}
