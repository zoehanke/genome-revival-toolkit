{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:review-v1",
  "title": "review-v1",
  "x-spec-ref": "D20 RV-3; A9",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "review-v1"
    },
    "object": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "rule-pack",
            "rule",
            "pipeline-template",
            "kit",
            "capability"
          ]
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "const": ""
        }
      ]
    },
    "scope": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "changes_requested"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "object",
    "scope",
    "decision",
    "notes"
  ],
  "additionalProperties": false
}
