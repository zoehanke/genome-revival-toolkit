{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grt:schema:verdict-v1",
  "title": "verdict-v1",
  "x-spec-ref": "D7; A6",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "integer",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "verdict-v1"
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "scope": {
      "enum": [
        "content_model",
        "preparation_model",
        "file",
        "user_goal"
      ]
    },
    "moment": {
      "enum": [
        "step",
        "final"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "constraint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "issuer": {
      "enum": [
        "check_capability",
        "tool_self_report",
        "host_expectation"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "applicability": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "minItems": 1
            }
          },
          "required": [
            "reason",
            "basis"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rule_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "does_not_establish": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "check",
    "scope",
    "moment",
    "subject",
    "outcome",
    "issuer",
    "summary",
    "evidence",
    "basis",
    "rule_refs",
    "does_not_establish"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "NOT_APPLICABLE"
          }
        }
      },
      "then": {
        "required": [
          "applicability"
        ],
        "properties": {
          "applicability": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "applicability": {
            "type": "null"
          }
        }
      }
    }
  ]
}
