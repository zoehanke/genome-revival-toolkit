{
  "schema": "capability-v1",
  "id": "check.goal.components_absent",
  "version": "0.0.0",
  "role": "CHECK",
  "summary": "Require every explicit component sequence to be absent from every target material.",
  "effects": [
    "reads_files"
  ],
  "deterministic": true,
  "requires_runtime": [],
  "inputs": [],
  "params": {
    "type": "object",
    "properties": {
      "components": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sequence": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[ACGTacgt]+$"
            },
            "strand": {
              "enum": [
                1,
                -1
              ]
            }
          },
          "required": [
            "name",
            "sequence"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "components"
    ],
    "additionalProperties": false
  },
  "outputs": [],
  "step_checks": [],
  "final_checks": [],
  "does_not_establish": [
    "Experimental performance, functional identity or truth of a reported claim.",
    "Constraint meaning beyond the explicit sequences, coordinates and report topic."
  ],
  "source": {
    "algorithm_refs": [
      "SPEC D2 GOL-4/GOL-6",
      "SPEC D9 retained content identities"
    ],
    "implemented_in": "dna_design_core.capabilities.builtin.check.goal:components_absent"
  },
  "owner": "core",
  "granularity": "atomic",
  "scope": "user_goal",
  "evaluates_constraint": true,
  "offline": true,
  "fixtures": {
    "pass": "tests/fixtures/goal_checks/components_absent.pass.json",
    "fail": "tests/fixtures/goal_checks/components_absent.fail.json"
  }
}
